# =============================================================================

data/raw/*
data/bronze/*
data/silver/*
data/gold/*
data/generated/*

# Keep folder structure
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/generated/.gitkeep

# =============================================================================
# LOGS
# =============================================================================

logs/*
!logs/.gitkeep

